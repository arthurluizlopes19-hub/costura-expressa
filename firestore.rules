rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só aparelhos que entraram com o e-mail e a senha do ateliê leem e gravam.
    // Login anônimo e contas criadas pelo próprio site são recusados.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
  }
}
