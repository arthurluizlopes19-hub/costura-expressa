rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Página pública do pedido (link enviado à cliente): só leitura, sem login.
    match /publico/{codigo} {
      allow read: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
